<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#312E81" />
    <SolidColorBrush x:Key="AccentIndigo" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentIndigoHover" Color="#4338CA" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2937" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#E5E7EB" />
    <BoxShadows x:Key="CardShadow">0 4 14 0 #0D000000</BoxShadows>
</ResourceDictionary>