<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- PATTERN: Locale_[Module]_[ElementType]_[Action] -->

    <!-- GLOBAL / SHARED -->
    <system:String x:Key="Locale_Global_Button_Save">Save</system:String>
    <system:String x:Key="Locale_Global_Button_Cancel">Cancel</system:String>
    <system:String x:Key="Locale_Global_Button_Confirm">Confirm</system:String>

    <!--NAVIGATION MENU ITEMS-->
    <system:String x:Key="Locale_Navigation_Menu_Dashboard">Dashboard</system:String>
    <system:String x:Key="Locale_Navigation_Menu_Ledger">Ledger</system:String>
    <system:String x:Key="Locale_Navigation_Menu_Statement_Import">Import Statements</system:String>
    <system:String x:Key="Locale_Navigation_Menu_Data_Taxanomy">Data &amp; Taxanomy</system:String>
    <system:String x:Key="Locale_Navigation_Menu_Reports">Reports</system:String>
    <system:String x:Key="Locale_Navigation_Menu_Audit_Logs">Audit Logs</system:String>

    <!-- GATEKEEPER MODULE -->
    <system:String x:Key="Locale_Gatekeeper_Title_Login">Welcome Back</system:String>
    <system:String x:Key="Locale_Gatekeeper_Label_ProfileName">Profile Name</system:String>
    <system:String x:Key="Locale_Gatekeeper_Label_Password">Master Vault Password</system:String>
    <system:String x:Key="Locale_Gatekeeper_Button_Login">Unlock Profile</system:String>

    <system:String x:Key="Locale_Gatekeeper_Title_Register">Create New Profile</system:String>
    <system:String x:Key="Locale_Gatekeeper_Label_BaseCurrency">Base Currency Symbol</system:String>
    <system:String x:Key="Locale_Gatekeeper_Button_Register">Generate Encrypted Vault</system:String>
    <system:String x:Key="Locale_Gatekeeper_Text_CurrencyWarning">This profile operates strictly in the selected currency. Imported foreign amounts will be recorded at a 1:1 face value without conversion.</system:String>

    <!-- Dashboard Module -->
    <system:String x:Key="Locale_Dashboard_Title">Dashboard</system:String>
    <system:String x:Key="Locale_Dashboard_WelcomeMessage">Welcome to your financial command center.</system:String>
    <system:String x:Key="Locale_Dashboard_Placeholder_NetWorth">Net Worth Tracker (Coming Soon)</system:String>
    <system:String x:Key="Locale_Dashboard_Placeholder_CashFlow">Cash Flow (Coming Soon)</system:String>
    <!-- Dashboard Quick Links -->
    <system:String x:Key="Locale_Dashboard_Button_ManageData">Manage Data &amp; Taxonomy</system:String>

    <!-- ========================================== -->
    <!-- DATA TAXONOMY HUB                        -->
    <!-- ========================================== -->

    <!-- Sidebar Menu -->
    <system:String x:Key="Locale_DataTaxonomy_SearchMenu">Search menu...</system:String>

    <!-- Common -->
    <system:String x:Key="Locale_DataTaxonomy_Common_Create">Create</system:String>
    <system:String x:Key="Locale_DataTaxonomy_Common_FilterBy">Filter By</system:String>
