    <!-- Account Details View: Header & AI Section -->
    <system:String x:Key="Locale_Module_Preview_AccountValidation_Title">Target Account Validation</system:String>
    <system:String x:Key="Locale_Module_Preview_AccountValidation_Subtitle">Confirm the destination account for these transactions. Data entered here determines where the imported records will be saved.</system:String>
    <system:String x:Key="Locale_Module_Preview_AiTraining_Title">Advanced: Teach AI for Next Time</system:String>
    <system:String x:Key="Locale_Module_Preview_AiTraining_Recommended">Recommended</system:String>
    <system:String x:Key="Locale_Module_Preview_AiTraining_DescTitle">Optional AI Training: </system:String>
    <system:String x:Key="Locale_Module_Preview_AiTraining_Description_1">If your raw Excel sheet contains text labels (like 'A/C No:'), type them below so the engine learns them for next time. </system:String>
    <system:String x:Key="Locale_Module_Preview_AiTraining_Description_2">If your sheet doesn't have these labels, simply leave these fields blank. Missing labels will NOT lower your confidence score.</system:String>
