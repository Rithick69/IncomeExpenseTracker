<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GLOBAL WINDOW STYLE -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource InterFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- UI COMPONENT: DATA CARDS -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- UI COMPONENT: PRIMARY BUTTONS -->
    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="{DynamicResource AccentIndigo}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentIndigoHover}"/>
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Button.Secondary">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- UI COMPONENT: TEXTBOX & COMBOBOX (Form Inputs) -->
    <Style Selector="TextBox, ComboBox, DropDownButton">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- UI COMPONENT: DROPDOWN BUTTON HOVER & PRESSED OVERRIDES -->

    <!-- HOVER STATE: Keep background static, highlight only the border -->
    <Style Selector="DropDownButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <!-- A slightly brighter border for the hover highlight -->
        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- PRESSED / FLYOUT OPEN STATE: Revert border to normal, keep background static -->
    <Style Selector="DropDownButton:pressed /template/ ContentPresenter#PART_ContentPresenter, DropDownButton:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- UI COMPONENT: DATAGRID (Tabular Numerals Enforced) -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimary}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <!-- Enforces tabular lining for numbers so columns of currency align perfectly -->
        <Setter Property="FontFeatures" Value="tnum"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
    </Style>

    <!-- TYPOGRAPHY: DASHBOARD NUMBERS -->
    <Style Selector="TextBlock.DisplayNumber">
        <Setter Property="Foreground" Value="{DynamicResource AccentIndigo}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.5"/>
    </Style>

    <!-- TYPOGRAPHY: SEMANTIC HEADERS -->
    <Style Selector="TextBlock.H1">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.H2">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.H3">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.Subtitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.HelperText">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- TYPOGRAPHY: FORM LABELS -->
    <Style Selector="TextBlock.FormLabel">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- UI COMPONENT: GHOST/ICON BUTTONS (e.g., Close 'X', transparent clear buttons) -->
    <Style Selector="Button.GhostIcon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Button.GhostIcon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- UI COMPONENT: ERROR HIGHLIGHTS -->
    <Style Selector="TextBox.Error, ComboBox.Error">
        <Setter Property="BorderBrush" Value="Red" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</Styles>