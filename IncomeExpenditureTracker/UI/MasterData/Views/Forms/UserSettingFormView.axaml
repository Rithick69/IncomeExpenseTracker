<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IncomeExpenditureTracker.UI.MasterData"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
             x:Class="IncomeExpenditureTracker.UI.MasterData.UserSettingFormView"
             x:DataType="vm:UserSettingFormViewModel"
             Width="400">

    <UserControl.Styles>
        <Style Selector="UserControl">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Border Classes="Card" Background="{DynamicResource BackgroundSecondary}" Padding="32">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="20">

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Locale_Forms_UserSetting_Title}"
                       Classes="DisplayNumber"
                       FontSize="24"
                       Margin="0,0,0,8"/>

            <!-- Row 1: Setting Key (Read-Only) -->
            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="{DynamicResource Locale_Forms_UserSetting_Key}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding SettingKey}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="14"/>
            </StackPanel>

            <!-- Row 2: Value -->
            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="{DynamicResource Locale_Forms_UserSetting_Value}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBox Text="{Binding SettingValue, Mode=TwoWay}" Watermark="{DynamicResource Locale_Forms_UserSetting_ValueWatermark}"/>
            </StackPanel>

            <!-- Action Bar -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,12,0,0">
                <Button Content="{DynamicResource Locale_Global_Button_Cancel}"
                        Command="{Binding CancelCommand}"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondary}"/>

                <Button Content="{DynamicResource Locale_Forms_UserSetting_Save}"
                        Classes="Primary"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>