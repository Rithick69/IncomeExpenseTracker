<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IncomeExpenditureTracker.UI.Reports.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="IncomeExpenditureTracker.UI.Reports.Views.SpendTrackerView"
             x:DataType="vm:SpendTrackerViewModel">

    <!-- Spend Tracker Report Tab: Monthly Income/Expense Trends + Category Breakdown -->
    <!-- NOTE: LiveCharts2 requires: dotnet add package LiveChartsCore.SkiaSharpView.Avalonia -->

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="24">

            <!-- ===================================================================== -->
            <!-- TOP SUMMARY WIDGETS (Total Income, Total Expense, Net Cashflow)      -->
            <!-- ===================================================================== -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">

                <!-- Widget 1: Total Income -->
                <Border Grid.Column="0" Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="Subtitle"
                                   Text="{DynamicResource Locale_Reports_Widget_TotalIncome}"/>
                        <TextBlock Classes="DisplayNumber"
                                   FontFeatures="tnum"
                                   Text="{Binding TotalIncome, StringFormat='₹{0:N2}'}"/>
                    </StackPanel>
                </Border>

                <!-- Widget 2: Total Expense -->
                <Border Grid.Column="1" Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="Subtitle"
                                   Text="{DynamicResource Locale_Reports_Widget_TotalExpense}"/>
                        <TextBlock Classes="DisplayNumber"
                                   FontFeatures="tnum"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding TotalExpense, StringFormat='₹{0:N2}'}"/>
                    </StackPanel>
                </Border>

                <!-- Widget 3: Net Cashflow -->
                <Border Grid.Column="2" Classes="Card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="Subtitle"
                                   Text="{DynamicResource Locale_Reports_Widget_NetCashflow}"/>
                        <TextBlock Classes="DisplayNumber"
                                   FontFeatures="tnum"
                                   Text="{Binding NetCashflow, StringFormat='₹{0:N2}'}"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ===================================================================== -->
            <!-- CHARTS ZONE                                                           -->
            <!-- ===================================================================== -->
            <Grid RowDefinitions="*" ColumnDefinitions="2*,*" ColumnSpacing="16">

                <!-- ============================================================= -->
                <!-- LEFT: Monthly Income vs. Expense Bar Chart                    -->
                <!-- ============================================================= -->
                <Border Grid.Column="0" Classes="Card" MinHeight="400">
                    <StackPanel Spacing="16">

                        <!-- Chart Title -->
                        <TextBlock Classes="H2"
                                   Text="{DynamicResource Locale_Reports_Chart_MonthlyTrend}"/>

                        <!-- LiveCharts2 Column Chart: Monthly Income vs Expense -->
                        <lvc:CartesianChart Series="{Binding MonthlyTrendSeries}"
                                            Height="350"
                                            XAxes="{Binding XAxes}"
                                            LegendPosition="Top"/>

                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- RIGHT: Category-wise Expense Doughnut Chart                  -->
                <!-- ============================================================= -->
                <Border Grid.Column="1" Classes="Card" MinHeight="400">
                    <StackPanel Spacing="16">

                        <!-- Chart Title -->
                        <TextBlock Classes="H2"
                                   Text="{DynamicResource Locale_Reports_Chart_CategoryBreakdown}"/>

                        <!-- LiveCharts2 Pie Chart: Category-wise Expense Breakdown -->
                        <lvc:PieChart Series="{Binding CategoryBreakdownSeries}"
                                      Height="350"
                                      LegendPosition="Right"/>

                    </StackPanel>
                </Border>

            </Grid>

            <!-- ===================================================================== -->
            <!-- DATA TABLE (Optional: Monthly Breakdown in Tabular Form)             -->
            <!-- ===================================================================== -->
            <Border Classes="Card">
                <StackPanel Spacing="12">

                    <TextBlock Classes="H2"
                               Text="{DynamicResource Locale_Reports_Table_MonthlyBreakdown}"/>

                    <TextBlock Classes="Subtitle"
                               Text="Charts are now powered by LiveCharts2. Toggle to table view for detailed breakdown (feature coming soon)."
                               TextWrapping="Wrap"
                               Opacity="0.7"/>

                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
