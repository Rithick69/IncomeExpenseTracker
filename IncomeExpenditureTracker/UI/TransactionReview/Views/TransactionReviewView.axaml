<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IncomeExpenditureTracker.UI.TransactionReview"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="IncomeExpenditureTracker.UI.TransactionReview.TransactionReviewView"
             x:DataType="vm:TransactionReviewViewModel">

    <!-- =========================================================================
         LOCAL DATAGRID STYLES (Preserves crisp column header borders during resize)
         ========================================================================= -->
    <UserControl.Styles>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="AreSeparatorsVisible" Value="True" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </UserControl.Styles>

    <!-- =========================================================================
         ROOT LAYOUT: Main Ledger Workspace (Col 0) + Slide-In Edit Panel (Col 1)
         ========================================================================= -->
    <Grid ColumnDefinitions="*,Auto">

        <!-- =====================================================================
             MAIN WORKSPACE: Top Bar (Row 0), Ledger Grid (Row 1), Footer (Row 2)
             ===================================================================== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" MinWidth="0">

            <!-- =================================================================
                 ZONE 1: TOP ACTION BAR (Triage, Search, Balance Pills & Filters)
                 ================================================================= -->
            <Border Grid.Row="0" Classes="Card" Margin="20,20,20,10" Padding="18,16">
                <StackPanel Spacing="14">

                    <!-- Row 0: Triage Mode + Live Search (Left) | Balance Pills + Review Edits (Right) -->
                    <Grid ColumnDefinitions="*,Auto">

                        <!-- Left Controls -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        Margin="0,0,20,6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Locale_Ledger_TriageMode_Label}"
                                           Classes="FormLabel"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch IsChecked="{Binding IsTriageMode}"
                                              Command="{Binding ToggleTriageModeCommand}"
                                              VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBox Text="{Binding SearchText}"
                                     Watermark="{DynamicResource Locale_Ledger_Search_Placeholder}"
                                     MinWidth="240"
                                     MaxWidth="360"
                                     Margin="0,0,15,6"
                                     VerticalAlignment="Center" />
                        </WrapPanel>

                        <!-- Right Metrics & Staging Checkout Trigger -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,6">

                            <!-- Conditional Selected Accounts Balance Pill (Hidden unless 1+ accounts filtered) -->
                            <Border Background="{DynamicResource BackgroundPrimary}"
                                    BorderBrush="{DynamicResource AccentSuccess}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    IsVisible="{Binding HasFilteredAccounts}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{DynamicResource Locale_Ledger_FilteredAccountBalance_Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding FilteredAccountBalance, StringFormat='{}{0:N2}'}"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentSuccess}"
                                               FontFeatures="tnum"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Always-Visible Global Total Balance Pill -->
                            <Border Background="{DynamicResource BackgroundPrimary}"
                                    BorderBrush="{DynamicResource AccentIndigo}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{DynamicResource Locale_Ledger_TotalBalance_Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding TotalGlobalBalance, StringFormat='{}{0:N2}'}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFeatures="tnum"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Review X Edits Badge Button -->
                            <Button Classes="Primary"
                                    Command="{Binding ReviewPendingEditsCommand}"
                                    IsVisible="{Binding HasStagedEdits}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{DynamicResource Locale_Ledger_ReviewEdits_Label}"
                                               VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentIndigoHover}"
                                            CornerRadius="12"
                                            Padding="8,2">
                                        <TextBlock Text="{Binding StagedEditsCount}"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="Bold"
                                                   FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource BorderSubtle}" Opacity="0.5" />

                    <!-- Row 1: Wrapping Multi-Select Filters, Grouping & Cross-Page Sorting Controls -->
                    <WrapPanel Orientation="Horizontal">

                        <!-- Start Date Filter -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_StartDate_Label}"
                                       Classes="FormLabel" />
                            <DatePicker SelectedDate="{Binding StartDate}"
                                        MinWidth="140" />
                        </StackPanel>

                        <!-- End Date Filter -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_EndDate_Label}"
                                       Classes="FormLabel" />
                            <DatePicker SelectedDate="{Binding EndDate}"
                                        MinWidth="140" />
                        </StackPanel>

                        <!-- Multi-Select Account Filter (Searchable Flyout + Clear) -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Account_Label}"
                                       Classes="FormLabel" />
                            <Button DataContext="{Binding AccountFilter}"
                                    x:DataType="vm:MultiSelectFilterViewModel"
                                    Classes="Secondary"
                                    MinWidth="190"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SummaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="280" Spacing="10" Margin="4">
                                            <TextBox Text="{Binding SearchQuery}"
                                                     Watermark="{DynamicResource Locale_Ledger_Filter_Search_Placeholder}" />
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableFilterOption">
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsVisible="{Binding IsVisible}"
                                                                      Margin="0,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Separator Background="{DynamicResource BorderSubtle}" />
                                            <Button Content="{DynamicResource Locale_Ledger_Filter_Clear_Button}"
                                                    Classes="Secondary"
                                                    Command="{Binding ClearSelectionCommand}"
                                                    IsEnabled="{Binding HasSelection}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    FontSize="12" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- Multi-Select Tag Filter (Searchable Flyout + Clear) -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Tag_Label}"
                                       Classes="FormLabel" />
                            <Button DataContext="{Binding TagFilter}"
                                    x:DataType="vm:MultiSelectFilterViewModel"
                                    Classes="Secondary"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SummaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="240" Spacing="10" Margin="4">
                                            <TextBox Text="{Binding SearchQuery}"
                                                     Watermark="{DynamicResource Locale_Ledger_Filter_Search_Placeholder}" />
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableFilterOption">
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsVisible="{Binding IsVisible}"
                                                                      Margin="0,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Separator Background="{DynamicResource BorderSubtle}" />
                                            <Button Content="{DynamicResource Locale_Ledger_Filter_Clear_Button}"
                                                    Classes="Secondary"
                                                    Command="{Binding ClearSelectionCommand}"
                                                    IsEnabled="{Binding HasSelection}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    FontSize="12" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- Multi-Select Payee Filter (Searchable Flyout + Clear) -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Payee_Label}"
                                       Classes="FormLabel" />
                            <Button DataContext="{Binding PayeeFilter}"
                                    x:DataType="vm:MultiSelectFilterViewModel"
                                    Classes="Secondary"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SummaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="240" Spacing="10" Margin="4">
                                            <TextBox Text="{Binding SearchQuery}"
                                                     Watermark="{DynamicResource Locale_Ledger_Filter_Search_Placeholder}" />
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableFilterOption">
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsVisible="{Binding IsVisible}"
                                                                      Margin="0,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Separator Background="{DynamicResource BorderSubtle}" />
                                            <Button Content="{DynamicResource Locale_Ledger_Filter_Clear_Button}"
                                                    Classes="Secondary"
                                                    Command="{Binding ClearSelectionCommand}"
                                                    IsEnabled="{Binding HasSelection}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    FontSize="12" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- Multi-Select Import Batch Filter (Searchable Flyout + Clear) -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_ImportBatch_Label}"
                                       Classes="FormLabel" />
                            <Button DataContext="{Binding BatchFilter}"
                                    x:DataType="vm:MultiSelectFilterViewModel"
                                    Classes="Secondary"
                                    MinWidth="180"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SummaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="280" Spacing="10" Margin="4">
                                            <TextBox Text="{Binding SearchQuery}"
                                                     Watermark="{DynamicResource Locale_Ledger_Filter_Search_Placeholder}" />
                                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectableFilterOption">
                                                            <CheckBox Content="{Binding DisplayName}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      IsVisible="{Binding IsVisible}"
                                                                      Margin="0,3" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Separator Background="{DynamicResource BorderSubtle}" />
                                            <Button Content="{DynamicResource Locale_Ledger_Filter_Clear_Button}"
                                                    Classes="Secondary"
                                                    Command="{Binding ClearSelectionCommand}"
                                                    IsEnabled="{Binding HasSelection}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    FontSize="12" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!-- Revert Batch Button (Visible only when exactly 1 specific batch is selected) -->
                        <Button Content="{DynamicResource Locale_Ledger_RevertBatch_Button}"
                                Background="{DynamicResource TextDanger}"
                                Foreground="#FFFFFF"
                                Command="{Binding RevertBatchCommand}"
                                IsVisible="{Binding IsBatchSelected}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,14,8" />

                        <!-- Group By Selector -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_GroupBy_Label}"
                                       Classes="FormLabel" />
                            <ComboBox ItemsSource="{Binding GroupByOptions}"
                                      SelectedItem="{Binding SelectedGroupBy}"
                                      PlaceholderText="{DynamicResource Locale_Ledger_GroupBy_Placeholder}"
                                      MinWidth="120" />
                        </StackPanel>

                        <!-- Cross-Page Sort By + Direction Toggle -->
                        <StackPanel Spacing="6" Margin="0,0,14,8">
                            <TextBlock Text="{DynamicResource Locale_Ledger_SortBy_Label}"
                                       Classes="FormLabel" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox ItemsSource="{Binding SortByOptions}"
                                          SelectedItem="{Binding SelectedSortBy}"
                                          MinWidth="110" />
                                <Button Content="{Binding SortDirectionIcon}"
                                        Classes="Secondary"
                                        Command="{Binding ToggleSortDirectionCommand}"
                                        ToolTip.Tip="{Binding SortDirectionTooltip}"
                                        FontWeight="Bold"
                                        Padding="10,6" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Reset Filters Button (Visible only when any filter is active) -->
                        <Button Content="{DynamicResource Locale_Ledger_ResetFilters_Button}"
                                Classes="Secondary"
                                Command="{Binding ClearFiltersCommand}"
                                IsVisible="{Binding HasActiveFilters}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,10,8" />

                        <!-- Manual Refresh Button -->
                        <Button Content="{DynamicResource Locale_Ledger_Refresh_Button}"
                                Classes="Secondary"
                                Command="{Binding RefreshGridCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- =================================================================
                 ZONE 2: TRANSACTION LEDGER (Slim Toolbar + Sticky-Header DataGrid)
                 ================================================================= -->
            <Border Grid.Row="1" Classes="Card" Margin="20,6,20,10" Padding="0">
                <Grid RowDefinitions="Auto,*">

                    <!-- Slim Table Toolbar: Selection Status + Bulk Actions Trigger -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0"
                            Padding="16,10">
                        <Grid ColumnDefinitions="*,Auto">

                            <!-- Left: Selection Counter & Subtle Guidance -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="12"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedCountText}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}"
                                           IsVisible="{Binding HasSelectedTransactions}"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{DynamicResource Locale_Ledger_BulkActions_Hint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding !CanOpenBulkActions}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right: Clear Selection + Highlighted Bulk Actions Button -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <Button Content="{DynamicResource Locale_Ledger_CancelSelection_Button}"
                                        Classes="Secondary"
                                        Command="{Binding CancelSelectionCommand}"
                                        IsVisible="{Binding HasSelectedTransactions}"
                                        FontSize="12"
                                        Padding="10,6" />

                                <Button Content="{Binding BulkActionsButtonText}"
                                        Classes.Primary="{Binding CanOpenBulkActions}"
                                        Classes.Secondary="{Binding !CanOpenBulkActions}"
                                        Command="{Binding OpenBulkActionsModalCommand}"
                                        IsEnabled="{Binding CanOpenBulkActions}"
                                        FontSize="12"
                                        Padding="14,6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main DataGrid (Unobstructed Sticky Column Headers + Persistent Borders) -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TransactionsView}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                              VerticalGridLinesBrush="{DynamicResource BorderSubtle}"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              HorizontalScrollBarVisibility="Auto"
                              FontFeatures="tnum"
                              DoubleTapped="OnRowDoubleTapped">

                        <DataGrid.Columns>

                            <!-- Select Checkbox Column (Wider Header Select-All + Draft Row Accent Stripe) -->
                            <DataGridTemplateColumn Width="64" CanUserResize="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding $parent[UserControl].((vm:TransactionReviewViewModel)DataContext).IsAllSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{DynamicResource Locale_Ledger_SelectAll_Tooltip}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                        <Grid>
                                            <!-- Subtle Left Indigo Stripe when row has pending staged edits -->
                                            <Border Width="3"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentIndigo}"
                                                    IsVisible="{Binding IsStaged}"
                                                    ToolTip.Tip="{DynamicResource Locale_Ledger_StagedEdit_Tooltip}" />
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Quick Edit Action Column (Increased width so 'Edit' header never clips) -->
                            <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Edit}"
                                                    Width="64"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                        <Button Content="✎"
                                                Classes="GhostIcon"
                                                Command="{Binding $parent[UserControl].((vm:TransactionReviewViewModel)DataContext).SelectTransactionCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Padding="6,4"
                                                ToolTip.Tip="{DynamicResource Locale_Ledger_Panel_Title}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Date Column -->
                            <DataGridTextColumn Header="{DynamicResource Locale_Ledger_Grid_Date}"
                                                Binding="{Binding Date, StringFormat='{}{0:dd-MMM-yyyy}', DataType=vm:TransactionRowViewModel}"
                                                Width="115" />

                            <!-- Account Column (Entity + Type + Masked Number) -->
                            <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Account}"
                                                    Width="195"
                                                    MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                        <TextBlock Text="{Binding AccountName}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding AccountName}"
                                                   Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Merchant Column (Bold Sanitized Source + Muted Raw Description + Full Tooltip) -->
                            <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Merchant}"
                                                    Width="260"
                                                    MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                        <StackPanel Spacing="3" Margin="6,6" VerticalAlignment="Center" Background="Transparent">
                                            <ToolTip.Tip>
                                                <StackPanel Spacing="4" MaxWidth="420">
                                                    <TextBlock Text="{Binding SanitizedSource}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding RawDescription}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ToolTip.Tip>
                                            <TextBlock Text="{Binding SanitizedSource}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RawDescription}"
                                                       Classes="HelperText"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Payee Column -->
                            <DataGridTextColumn Header="{DynamicResource Locale_Ledger_Grid_Payee}"
                                                Binding="{Binding PayeeName, DataType=vm:TransactionRowViewModel}"
                                                Width="140" />

                            <!-- Tag Column -->
                            <DataGridTextColumn Header="{DynamicResource Locale_Ledger_Grid_Tag}"
                                                Binding="{Binding TagName, DataType=vm:TransactionRowViewModel}"
                                                Width="135" />

                            <!-- Debit Column -->
                            <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Debit}"
                                                    Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                        <TextBlock Text="{Binding Debit, StringFormat='{}{0:N2}'}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextDanger}"
                                                   FontFeatures="tnum"
                                                   Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Credit Column -->
                            <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Credit}"
                                                    Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                        <TextBlock Text="{Binding Credit, StringFormat='{}{0:N2}'}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentSuccess}"
                                                   FontFeatures="tnum"
                                                   Margin="0,0,12,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Priority Status Icon Column (Increased width so 'Status' header never clips) -->
                            <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Status}"
                                                    Width="86"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowViewModel">
                                        <Border HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="12"
                                                Padding="8,4"
                                                Background="{DynamicResource BackgroundPrimary}"
                                                ToolTip.Tip="{Binding StatusTooltip}">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- =================================================================
                 ZONE 3 (BOTTOM): PAGINATION FOOTER BAR
                 ================================================================= -->
            <Border Grid.Row="2" Classes="Card" Margin="20,4,20,20" Padding="16,10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding PageInfo}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,15,0">
                        <TextBlock Text="{DynamicResource Locale_Ledger_PageSize_Label}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                  SelectedItem="{Binding SelectedPageSize}"
                                  MinWidth="80" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="◀"
                            Classes="Secondary"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"
                            Margin="0,0,6,0"
                            ToolTip.Tip="{DynamicResource Locale_Ledger_Previous_Button}" />

                    <Button Grid.Column="3"
                            Content="▶"
                            Classes="Secondary"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            ToolTip.Tip="{DynamicResource Locale_Ledger_Next_Button}" />
                </Grid>
            </Border>
        </Grid>

        <!-- =====================================================================
             ZONE 3 (RIGHT): SLIDE-IN EDIT PANEL (Sticky Header + Scrollable Form + Sticky Footer)
             ===================================================================== -->
        <Border Grid.Column="1"
                Classes="Card"
                Width="390"
                Margin="0,20,20,20"
                Padding="0"
                IsVisible="{Binding IsPanelVisible}">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Sticky Panel Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource Locale_Ledger_Panel_Title}"
                                   Classes="H2"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Classes="GhostIcon"
                                Command="{Binding CancelEditCommand}"
                                FontSize="18" />
                    </Grid>
                </Border>

                <!-- Scrollable Form Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel Spacing="16">

                        <!-- Audit Trail: Raw Amount Text -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Panel_RawAmount_Label}"
                                       Classes="FormLabel" />
                            <Border Background="{DynamicResource BackgroundPrimary}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8">
                                <TextBlock Text="{Binding RawAmountText}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Consolas,Monaco,Courier New"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- Editable Date Field -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Panel_Date_Label}"
                                       Classes="FormLabel" />
                            <DatePicker SelectedDate="{Binding EditDate}"
                                        HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Editable Debit & Credit Fields (Side by Side) -->
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{DynamicResource Locale_Ledger_Panel_Debit_Label}"
                                           Classes="FormLabel" />
                                <TextBox Text="{Binding EditDebit}"
                                         Watermark="0.00" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="{DynamicResource Locale_Ledger_Panel_Credit_Label}"
                                           Classes="FormLabel" />
                                <TextBox Text="{Binding EditCredit}"
                                         Watermark="0.00" />
                            </StackPanel>
                        </Grid>

                        <!-- Editable Payee (Searchable AutoCompleteBox) -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Panel_Payee_Label}"
                                       Classes="FormLabel" />
                            <AutoCompleteBox Text="{Binding EditPayee}"
                                             ItemsSource="{Binding AvailablePayees}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             Watermark="{DynamicResource Locale_Ledger_Panel_Payee_Placeholder}" />
                        </StackPanel>

                        <!-- Editable Tag (Searchable AutoCompleteBox) -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Panel_Tag_Label}"
                                       Classes="FormLabel" />
                            <AutoCompleteBox Text="{Binding EditTag}"
                                             ItemsSource="{Binding AvailableTags}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             Watermark="{DynamicResource Locale_Ledger_Panel_Tag_Placeholder}" />
                        </StackPanel>

                        <!-- Editable Memo Field -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Locale_Ledger_Panel_Memo_Label}"
                                       Classes="FormLabel" />
                            <TextBox Text="{Binding EditMemo}"
                                     Watermark="{DynamicResource Locale_Ledger_Panel_Memo_Placeholder}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="64" />
                        </StackPanel>

                        <!-- Split Transaction Expander (Spacious Stacked Cards + Live Allocation Summary) -->
                        <Expander Header="{DynamicResource Locale_Ledger_Panel_SplitTransaction_Label}"
                                  HorizontalAlignment="Stretch"
                                  IsExpanded="False">
                            <StackPanel Spacing="12" Margin="0,10,0,0">

                                <!-- Live Allocation Summary Card -->
                                <Border Background="{DynamicResource BackgroundPrimary}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{DynamicResource Locale_Ledger_Split_Original_Label}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="{Binding SplitTargetAmount, StringFormat='{}{0:N2}'}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       FontFeatures="tnum"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Locale_Ledger_Split_Allocated_Label}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding SplitAllocatedAmount, StringFormat='{}{0:N2}'}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       FontFeatures="tnum"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{DynamicResource Locale_Ledger_Split_Remaining_Label}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding SplitRemainingAmount, StringFormat='{}{0:N2}'}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       FontFeatures="tnum"
                                                       Foreground="{Binding SplitStatusColor}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Vertically Stacked Split Line Cards -->
                                <ItemsControl ItemsSource="{Binding MockSplitTransactions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SplitLineViewModel">
                                            <Border Background="{DynamicResource BackgroundPrimary}"
                                                    BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,0,0,10">
                                                <StackPanel Spacing="10">

                                                    <!-- Card Header: Split #N + Remove Button -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding LineHeader}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AccentIndigoHover}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Content="✕"
                                                                Classes="GhostIcon"
                                                                Command="{Binding $parent[UserControl].((vm:TransactionReviewViewModel)DataContext).RemoveSplitLineCommand}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,2"
                                                                FontSize="12"
                                                                ToolTip.Tip="{DynamicResource Locale_Ledger_Split_Remove_Button}" />
                                                    </Grid>

                                                    <!-- Full-Width Split Amount -->
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{DynamicResource Locale_Ledger_Split_Amount_Label}"
                                                                   Classes="FormLabel"
                                                                   FontSize="11" />
                                                        <TextBox Text="{Binding SplitAmount}"
                                                                 Watermark="0.00"
                                                                 FontFeatures="tnum"
                                                                 HorizontalAlignment="Stretch" />
                                                    </StackPanel>

                                                    <!-- Full-Width Split Tag -->
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{DynamicResource Locale_Ledger_Split_Tag_Label}"
                                                                   Classes="FormLabel"
                                                                   FontSize="11" />
                                                        <AutoCompleteBox Text="{Binding SplitTag}"
                                                                         ItemsSource="{Binding $parent[UserControl].((vm:TransactionReviewViewModel)DataContext).AvailableTags}"
                                                                         FilterMode="Contains"
                                                                         MinimumPrefixLength="0"
                                                                         Watermark="{DynamicResource Locale_Ledger_Panel_Tag_Placeholder}"
                                                                         HorizontalAlignment="Stretch" />
                                                    </StackPanel>

                                                    <!-- Full-Width Split Payee -->
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{DynamicResource Locale_Ledger_Split_Payee_Label}"
                                                                   Classes="FormLabel"
                                                                   FontSize="11" />
                                                        <AutoCompleteBox Text="{Binding SplitPayee}"
                                                                         ItemsSource="{Binding $parent[UserControl].((vm:TransactionReviewViewModel)DataContext).AvailablePayees}"
                                                                         FilterMode="Contains"
                                                                         MinimumPrefixLength="0"
                                                                         Watermark="{DynamicResource Locale_Ledger_Panel_Payee_Placeholder}"
                                                                         HorizontalAlignment="Stretch" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Split Action Buttons (Stages the split; does not write directly to DB) -->
                                <Grid ColumnDefinitions="*,8,*">
                                    <Button Grid.Column="0"
                                            Content="{DynamicResource Locale_Ledger_AddSplitLine_Button}"
                                            Classes="Secondary"
                                            Command="{Binding AddSplitLineCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            FontSize="12"
                                            Padding="8,8" />

                                    <Button Grid.Column="2"
                                            Content="{DynamicResource Locale_Ledger_StageSplit_Button}"
                                            Classes="Primary"
                                            Command="{Binding CommitSplitCommand}"
                                            IsEnabled="{Binding CanCommitSplit}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            FontSize="12"
                                            Padding="8,8" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sticky Panel Footer (Always visible without scrolling) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundSecondary}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8"
                        Padding="20,14">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,10,*">
                            <Button Grid.Column="0"
                                    Content="{DynamicResource Locale_Ledger_Panel_Cancel_Button}"
                                    Classes="Secondary"
                                    Command="{Binding CancelEditCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />

                            <Button Grid.Column="2"
                                    Content="{DynamicResource Locale_Ledger_Panel_StageUpdates_Button}"
                                    Classes="Primary"
                                    Command="{Binding StageUpdatesCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- Stage Revert Split Button (Visible only when selected row is a Split Parent) -->
                        <Button Content="{DynamicResource Locale_Ledger_Panel_StageRevertSplit_Button}"
                                Background="{DynamicResource TextDanger}"
                                Foreground="#FFFFFF"
                                Command="{Binding RevertSplitCommand}"
                                IsVisible="{Binding SelectedTransaction.IsSplitParent, FallbackValue=False}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- =====================================================================
             ZONE 4A: FLOATING BULK ACTIONS MODAL (Z-Index 100)
             ===================================================================== -->
        <Grid Background="#B3000000"
              ZIndex="100"
              Grid.ColumnSpan="2"
              IsVisible="{Binding IsBulkActionsModalVisible}">

            <Border Classes="Card"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="520"
                    Margin="24"
                    Padding="0">
                <StackPanel>

                    <!-- Modal Header -->
                    <Border Background="{DynamicResource BackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0"
                            Padding="24,16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Locale_Ledger_BulkModal_Title}"
                                           Classes="H2"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentIndigo}"
                                        CornerRadius="12"
                                        Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCountText}"
                                               Foreground="#FFFFFF"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Classes="GhostIcon"
                                    Command="{Binding CloseBulkActionsModalCommand}"
                                    FontSize="18" />
                        </Grid>
                    </Border>

                    <!-- Modal Body -->
                    <StackPanel Spacing="16" Margin="24,20">

                        <!-- Purpose Description -->
                        <TextBlock Text="{DynamicResource Locale_Ledger_BulkModal_Description}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   FontSize="13" />

                        <!-- Bulk Tag Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Locale_Ledger_BulkTag_Label}"
                                       Classes="FormLabel" />
                            <AutoCompleteBox Text="{Binding BulkTag}"
                                             ItemsSource="{Binding AvailableTags}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             Watermark="{DynamicResource Locale_Ledger_BulkTag_Placeholder}"
                                             HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Bulk Payee Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Locale_Ledger_BulkPayee_Label}"
                                       Classes="FormLabel" />
                            <AutoCompleteBox Text="{Binding BulkPayee}"
                                             ItemsSource="{Binding AvailablePayees}"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             Watermark="{DynamicResource Locale_Ledger_BulkPayee_Placeholder}"
                                             HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Transfer Linking Callout -->
                        <Border Background="{DynamicResource BackgroundPrimary}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Locale_Ledger_BulkModal_TransferTitle}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{DynamicResource Locale_Ledger_BulkModal_TransferSubtitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{DynamicResource Locale_Ledger_LinkTransfer_Button}"
                                        Classes="Secondary"
                                        Command="{Binding LinkAsTransferCommand}"
                                        IsEnabled="{Binding CanLinkTransfer}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Modal Footer -->
                    <Border Background="{DynamicResource BackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8"
                            Padding="24,14">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Grid.Column="0"
                                    Content="{DynamicResource Locale_Ledger_CancelSelection_Button}"
                                    Classes="Secondary"
                                    Command="{Binding CancelSelectionCommand}" />

                            <Button Grid.Column="2"
                                    Content="{DynamicResource Locale_Ledger_Panel_Cancel_Button}"
                                    Classes="Secondary"
                                    Command="{Binding CloseBulkActionsModalCommand}"
                                    Margin="0,0,10,0" />

                            <Button Grid.Column="3"
                                    Content="{DynamicResource Locale_Ledger_BulkApply_Button}"
                                    Classes="Primary"
                                    Command="{Binding ApplyBulkChangesCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- =====================================================================
             ZONE 4B: RESPONSIVE FULL-SCREEN STAGING OVERLAY (Z-Index 105)
             ===================================================================== -->
        <Grid Background="#CC000000"
              ZIndex="105"
              Grid.ColumnSpan="2"
              IsVisible="{Binding IsStagingModalVisible}">

            <Border Classes="Card"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="24"
                    MaxWidth="1360"
                    MaxHeight="840"
                    Padding="0"
                    DataContext="{Binding StagingViewModel}"
                    x:DataType="vm:StagingReviewModalViewModel">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Sticky Modal Header with Top-Right Close Button -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            Padding="20,16"
                            CornerRadius="8,8,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Locale_Ledger_StagingModal_Title}"
                                           Classes="H2"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentIndigo}"
                                        CornerRadius="12"
                                        Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalEditsCount}"
                                               Foreground="#FFFFFF"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Classes="GhostIcon"
                                    Command="{Binding CloseCommand}"
                                    IsEnabled="{Binding !IsCommitting}"
                                    ToolTip.Tip="{DynamicResource Locale_Ledger_StagingModal_CloseTooltip}"
                                    FontSize="20"
                                    Padding="8,4" />
                        </Grid>
                    </Border>

                    <!-- Responsive Staged Corrections DataGrid -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="20,14">
                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource Locale_Ledger_StagingModal_Subtitle}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Margin="0,0,0,12" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding StagedCorrections}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="{DynamicResource BorderSubtle}"
                                  VerticalGridLinesBrush="{DynamicResource BorderSubtle}"
                                  HeadersVisibility="Column"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  FontFeatures="tnum">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Locale_Ledger_StagingModal_ActionType}"
                                                    Binding="{Binding ActionSummary, DataType=vm:TransactionCorrectionRowViewModel}"
                                                    Width="160"
                                                    MinWidth="120" />
                                <DataGridTextColumn Header="{DynamicResource Locale_Ledger_Grid_Date}"
                                                    Binding="{Binding Date, StringFormat='{}{0:dd-MMM-yyyy}', DataType=vm:TransactionCorrectionRowViewModel}"
                                                    Width="115" />
                                <DataGridTextColumn Header="{DynamicResource Locale_Ledger_StagingModal_OriginalMerchant}"
                                                    Binding="{Binding OriginalMerchant, DataType=vm:TransactionCorrectionRowViewModel}"
                                                    Width="*"
                                                    MinWidth="180" />
                                <DataGridTextColumn Header="{DynamicResource Locale_Ledger_StagingModal_NewPayee}"
                                                    Binding="{Binding NewPayee, DataType=vm:TransactionCorrectionRowViewModel}"
                                                    Width="140"
                                                    MinWidth="110" />
                                <DataGridTextColumn Header="{DynamicResource Locale_Ledger_StagingModal_NewTag}"
                                                    Binding="{Binding NewTag, DataType=vm:TransactionCorrectionRowViewModel}"
                                                    Width="140"
                                                    MinWidth="110" />

                                <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Debit}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:TransactionCorrectionRowViewModel">
                                            <TextBlock Text="{Binding CorrectedDebit, StringFormat='{}{0:N2}'}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDanger}"
                                                       FontFeatures="tnum"
                                                       Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_Grid_Credit}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:TransactionCorrectionRowViewModel">
                                            <TextBlock Text="{Binding CorrectedCredit, StringFormat='{}{0:N2}'}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentSuccess}"
                                                       FontFeatures="tnum"
                                                       Margin="0,0,12,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{DynamicResource Locale_Ledger_StagingModal_Actions}"
                                                        Width="80"
                                                        CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:TransactionCorrectionRowViewModel">
                                            <Button Content="🗑"
                                                    Classes="GhostIcon"
                                                    Command="{Binding $parent[UserControl].((vm:TransactionReviewViewModel)DataContext).StagingViewModel.DiscardCorrectionCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding $parent[UserControl].((vm:TransactionReviewViewModel)DataContext).StagingViewModel.CanCommit}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Responsive Sticky Modal Footer (Summary + Discard All + Commit) -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0,1,0,0"
                            Padding="20,14"
                            CornerRadius="0,0,8,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding FooterSummary}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Locale_Ledger_StagingModal_FooterHelper}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource Locale_Ledger_StagingModal_DiscardAllButton}"
                                        Background="{DynamicResource TextDanger}"
                                        Foreground="#FFFFFF"
                                        Command="{Binding DiscardAllCommand}"
                                        IsEnabled="{Binding CanCommit}"
                                        FontSize="13"
                                        Padding="16,10"
                                        Margin="0,4,10,4"
                                        VerticalAlignment="Center" />

                                <Button Content="{DynamicResource Locale_Ledger_StagingModal_CommitButton}"
                                        Classes="Primary"
                                        Command="{Binding CommitUpdatesCommand}"
                                        IsEnabled="{Binding CanCommit}"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Padding="24,10"
                                        Margin="0,4,0,4"
                                        VerticalAlignment="Center" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>