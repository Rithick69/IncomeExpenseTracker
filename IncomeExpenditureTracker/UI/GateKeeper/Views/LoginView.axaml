<!--
  @component  LoginView
  @desc       Presentational layout for user authentication (Netflix-Style Profile Selector)
  @route      /UI/Gatekeeper/LoginView.axaml
  @access     Public (Rendered in MainWindow)
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IncomeExpenditureTracker.UI.Gatekeeper"
             x:Class="IncomeExpenditureTracker.UI.Gatekeeper.LoginView"
             x:DataType="vm:LoginViewModel"
             x:Name="RootControl">

    <!-- The UserControl Background now inherits from App.axaml Window Style -->

    <Design.DataContext>
        <vm:LoginViewModel/>
    </Design.DataContext>

    <!--
      GLOBAL DESIGN SYSTEM ALIGNMENT:
      Utilizing the 'Card' class defined in App.axaml for unified Background, CornerRadius, and Shadow.
    -->
    <Border Classes="Card"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="400"
            Padding="40">

        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

            <!-- @desc Header -->
            <TextBlock Grid.Row="0"
                       Text="{DynamicResource Locale_Gatekeeper_Title_Login}"
                       Classes="DisplayNumber"
                       FontSize="26"
                       Margin="0,0,0,30"
                       HorizontalAlignment="Center"/>

            <!-- ========================================== -->
            <!-- PHASE 1: THE NETFLIX GRID                  -->
            <!-- ========================================== -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Profiles}"
                          IsVisible="{Binding !IsPasswordPromptVisible}"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Clicking the button passes the ProfileDto to the command -->
                        <Button Content="{Binding Nickname}"
                                Classes="Secondary"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"
                                Command="{Binding #RootControl.((vm:LoginViewModel)DataContext).SelectProfileCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ========================================== -->
            <!-- PHASE 2: THE SECURE PASSWORD PROMPT        -->
            <!-- ========================================== -->
            <StackPanel Grid.Row="1" IsVisible="{Binding IsPasswordPromptVisible}" Spacing="15">

                <!-- Greeting utilizing the Nickname -->
                <TextBlock Text="{Binding SelectedProfile.Nickname, StringFormat='Welcome back, {0}'}"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                <!-- Autofilled ProfileName (Read-Only) -->
                <TextBox Text="{Binding Username}"
                         IsReadOnly="True"
                         Watermark="Profile Name" />

                <!-- Standard Login Controls (Hidden if Delete is active) -->
                <StackPanel IsVisible="{Binding !IsDeletePromptVisible}" Spacing="15">

                    <TextBox x:Name="VaultPasswordBox"
                             Watermark="Enter Profile Password"
                             PasswordChar="•"
                             Classes="revealPasswordButton" />

                    <Button Content="{Binding LoginButtonText}"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding #VaultPasswordBox}"
                            Classes="Primary"
                            HorizontalAlignment="Stretch" />

                    <Grid ColumnDefinitions="*,*">
                        <!-- Switch to Delete mode -->
                        <Button Grid.Column="0"
                                Content="Delete Profile"
                                Command="{Binding InitiateDeleteCommand}"
                                Background="Transparent"
                                Foreground="Red"
                                HorizontalAlignment="Left" />

                        <!-- Back Button to return to the grid -->
                        <Button Grid.Column="1"
                                Content="{DynamicResource Locale_Global_Button_Cancel}"
                                Command="{Binding CancelSelectionCommand}"
                                Classes="Secondary"
                                HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- ========================================== -->
                <!-- PHASE 3: THE VAULT NUKE PROMPT             -->
                <!-- ========================================== -->
                <StackPanel IsVisible="{Binding IsDeletePromptVisible}" Spacing="15">

                    <TextBlock Text="Enter Password or Master Key to authorize deletion:"
                               Foreground="Red"
                               TextWrapping="Wrap"/>

                    <TextBox x:Name="DeleteAuthBox" PasswordChar="•" />

                    <Button Content="PERMANENTLY DELETE"
                            Command="{Binding ConfirmDeleteCommand}"
                            CommandParameter="{Binding #DeleteAuthBox}"
                            Background="Red"
                            Foreground="White"
                            HorizontalAlignment="Stretch" />

                    <Button Content="{DynamicResource Locale_Global_Button_Cancel}"
                            Command="{Binding CancelDeleteCommand}"
                            Classes="Secondary"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>

            <!-- @desc Error Message Display (Shared across all phases) -->
            <TextBlock Grid.Row="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="#EF4444"
                       Margin="0,20,0,0"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- @desc Create a new Profile (Hidden when entering password) -->
            <Button Grid.Row="3"
                    Content="Create a new profile"
                    Command="{Binding NavigateToRegisterCommand}"
                    IsVisible="{Binding !IsPasswordPromptVisible}"
                    Background="Transparent"
                    Foreground="{DynamicResource AccentIndigo}"
                    Cursor="Hand"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center" />
            <!-- @desc Emergency Factory Reset (Developer Tool) -->
            <Button Grid.Row="4"
                    Content="Factory Reset App"
                    Command="{Binding FactoryResetCommand}"
                    IsVisible="{Binding !IsPasswordPromptVisible}"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    FontSize="12"
                    Cursor="Hand"
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="TextBlock.Foreground" Value="Red"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Border>
</UserControl>