<!--
  @component  RegisterView
  @desc       Presentational layout for creating a new isolated profile vault
  @route      /UI/Gatekeeper/RegisterView.axaml
  @access     Public (Rendered in MainWindow)
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IncomeExpenditureTracker.UI.Gatekeeper"
             x:Class="IncomeExpenditureTracker.UI.Gatekeeper.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <!-- The UserControl Background now inherits from App.axaml Window Style -->

    <Design.DataContext>
        <vm:RegisterViewModel/>
    </Design.DataContext>

    <!--
      GLOBAL DESIGN SYSTEM ALIGNMENT:
      Utilizing the 'Card' class defined in App.axaml for unified Background, CornerRadius, and Shadow.
    -->
    <Border Classes="Card"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="450"
            Padding="40">

        <StackPanel Spacing="15">

            <!-- @desc Header -->
            <TextBlock Text="{DynamicResource Locale_Gatekeeper_Title_Register}"
                       Classes="DisplayNumber"
                       FontSize="26"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <!-- System Profile Name -->
            <TextBox Watermark="System Profile Name (e.g. JohnDoe_Main)"
                     Text="{Binding ProfileName}" />

            <!-- Display Nickname -->
            <TextBox Watermark="Display Nickname (e.g. John)"
                     Text="{Binding Nickname}" />

            <!-- Base Currency Selection -->
            <StackPanel Spacing="5" Margin="0,5">
                <TextBlock Text="{DynamicResource Locale_Gatekeeper_Label_BaseCurrency}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontWeight="SemiBold"
                           FontSize="12"/>

                <ComboBox ItemsSource="{Binding AvailableCurrencies}"
                          SelectedItem="{Binding SelectedCurrency}"
                          HorizontalAlignment="Stretch" />

                <TextBlock Text="{DynamicResource Locale_Gatekeeper_Text_CurrencyWarning}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Secure Password Input -->
            <TextBox x:Name="NewPasswordInput"
                     Watermark="Enter Password"
                     PasswordChar="•"
                     Classes="revealPasswordButton" />

            <!-- Submit Button -->
            <Button Content="{Binding RegisterButtonText}"
                    Command="{Binding RegisterCommand}"
                    CommandParameter="{Binding #NewPasswordInput}"
                    Classes="Primary"
                    HorizontalAlignment="Stretch"
                    Margin="0,10,0,0"/>

            <!-- Error Message Display -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#EF4444"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Back to Login -->
            <Button Content="Back to Login"
                    Command="{Binding NavigateToLoginCommand}"
                    Classes="Secondary"
                    Background="Transparent"
                    Foreground="{DynamicResource AccentIndigo}"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Margin="0,10,0,0" />

        </StackPanel>
    </Border>
</UserControl>