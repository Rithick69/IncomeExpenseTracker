<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IncomeExpenditureTracker.UI.ImportHub"
             x:Class="IncomeExpenditureTracker.UI.ImportHub.AccountDetailsView"
             x:DataType="vm:SheetPreviewViewModel">

    <ScrollViewer Padding="10,10,10,40" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Spacing="5">
                <TextBlock Classes="H2" Text="{DynamicResource Locale_Module_Preview_AccountValidation_Title}"/>
                <TextBlock Classes="Subtitle" Text="{DynamicResource Locale_Module_Preview_AccountValidation_Subtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- OPTIONAL: AI TRAINING SECTION -->
            <Expander IsExpanded="{Binding IsAiTrainingExpanded}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{DynamicResource Locale_Module_Preview_AiTraining_Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource AccentIndigo}" CornerRadius="10" Padding="8,2" IsVisible="{Binding SuggestAiTraining}">
                            <TextBlock Text="{DynamicResource Locale_Module_Preview_AiTraining_Recommended}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Expander.Header>

                <StackPanel Spacing="12" Margin="10,10,10,5">
                    <TextBlock Classes="HelperText" Text="{DynamicResource Locale_Module_Preview_AiTraining_Description}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="1*,1*,1*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="15">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Classes="HelperText" Margin="0,0,0,4" Text="{DynamicResource Locale_Module_Preview_AiTraining_BankLabel}"/>
                            <TextBox Text="{Binding SelectedEntityNameLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Classes="HelperText" Margin="0,0,0,4" Text="{DynamicResource Locale_Module_Preview_AiTraining_AccountLabel}"/>
                            <TextBox Text="{Binding SelectedAccountNumberLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Classes="HelperText" Margin="0,0,0,4" Text="{DynamicResource Locale_Module_Preview_AiTraining_CardLabel}"/>
                            <TextBox Text="{Binding SelectedCardNumberLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Classes="HelperText" Margin="0,0,0,4" Text="{DynamicResource Locale_Module_Preview_AiTraining_TypeLabel}"/>
                            <TextBox Text="{Binding SelectedAccountTypeLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Classes="HelperText" Margin="0,0,0,4" Text="{DynamicResource Locale_Module_Preview_AiTraining_CurrencyLabel}"/>
                            <TextBox Text="{Binding SelectedCurrencyLabel}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- PRIMARY FORM: REQUIRED DATA -->
            <Border Classes="Card">
                <Grid ColumnDefinitions="1*, 1*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="15" ColumnSpacing="20">

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Classes="FormLabel" Text="{DynamicResource Locale_Module_Preview_Form_BankName}" />
                        <AutoCompleteBox Text="{Binding AccountMapping.EntityName}" ItemsSource="{Binding AccountMapping.AvailableEntityNames}" FilterMode="None" Watermark="{DynamicResource Locale_Module_Preview_Form_BankName_Watermark}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Classes="FormLabel" Text="{DynamicResource Locale_Module_Preview_Form_AccountNumber}" />
                        <AutoCompleteBox Text="{Binding AccountMapping.AccountNumber}" ItemsSource="{Binding AccountMapping.AvailableAccountNumbers}" FilterMode="None" IsEnabled="{Binding AccountMapping.IsAccountNumberEnabled}" Watermark="{DynamicResource Locale_Module_Preview_Form_AccountNumber_Watermark}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Classes="FormLabel" Text="{DynamicResource Locale_Module_Preview_Form_CardNumber}" />
                        <AutoCompleteBox Text="{Binding AccountMapping.CardNumber}" ItemsSource="{Binding AccountMapping.AvailableCardNumbers}" FilterMode="None" IsEnabled="{Binding AccountMapping.IsCardNumberEnabled}" Watermark="{DynamicResource Locale_Module_Preview_Form_CardNumber_Watermark}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding AccountMapping.IsCreditLimitVisible}">
                        <TextBlock Classes="FormLabel" Text="{DynamicResource Locale_Module_Preview_Form_CreditLimit}" />
                        <TextBox Text="{Binding AccountMapping.CreditLimit}" Watermark="{DynamicResource Locale_Module_Preview_Form_CreditLimit_Watermark}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Classes="FormLabel" Text="{DynamicResource Locale_Module_Preview_Form_AccountType}" />
                        <ComboBox SelectedItem="{Binding AccountMapping.AccountType}" ItemsSource="{Binding AccountMapping.AvailableAccountTypes}" HorizontalAlignment="Stretch" PlaceholderText="{DynamicResource Locale_Module_Preview_Form_AccountType_Placeholder}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Classes="FormLabel" Text="{DynamicResource Locale_Module_Preview_Form_Currency}" />
                        <ComboBox SelectedItem="{Binding AccountMapping.Currency}" ItemsSource="{Binding AccountMapping.AvailableCurrencies}" HorizontalAlignment="Stretch" PlaceholderText="{DynamicResource Locale_Module_Preview_Form_Currency_Placeholder}" />
                    </StackPanel>

                </Grid>
            </Border>

            <Panel Height="100" Background="Transparent" />

        </StackPanel>
    </ScrollViewer>
</UserControl>